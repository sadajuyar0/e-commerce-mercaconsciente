---
import MainLayout from '@/layouts/MainLayout.astro';
import ProductCatalog from '@/components/products/ProductCatalog';
import { getCategories, getProducts } from '@/services/productService';

const [products, categories] = await Promise.all([getProducts(), getCategories()]);
---
<MainLayout title="Tienda | Mercaconsciente" description="Navega la oferta actual de pequeños productores locales y encuentra alimentos y productos naturales hechos con cuidado.">
  <section class="site-container pb-20 pt-12 sm:pt-16">
    <div class="mb-9 max-w-3xl sm:mb-12"><p class="eyebrow">La oferta de temporada</p><h1 class="display-heading mt-5">Hecho por personas, elegido por ti.</h1><p class="mt-5 max-w-xl text-sm leading-6 text-ink/65">Una selección de {products.length} productos de {new Set(products.map((item) => item.producer)).size} proyectos productores. Explora, conoce quién los hace y arma tu pedido.</p></div>
    <ProductCatalog client:load products={products} categories={categories} />
  </section>
</MainLayout>